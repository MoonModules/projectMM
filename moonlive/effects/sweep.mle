// Sweep: the moving-head formations, in script form. MOTION ONLY, no color.

class SweepEffect {
  byte formation = 0;
  byte panBpm = 6;
  byte tiltBpm = 9;
  byte panRange = 128;
  byte tiltRange = 96;

  int dimensions() { return 1; }

  string tags() { return "💫🎯"; }

  void defineControls() {
    addControl("formation", formation, 0, 4);       // 0 fan, 1 mirror, 2 chase, 3 cross, 4 unison
    addControl("panBpm", panBpm, 1, 120);           // how fast the heads swing sideways
    addControl("tiltBpm", tiltBpm, 1, 120);         // how fast they swing up and down
    addControl("panRange", panRange, 0, 255);       // how far the sideways swing travels
    addControl("tiltRange", tiltRange, 0, 255);     // how far the vertical swing travels
  }

  void tick() {
    for (int i = 0; i < height; i = i + 1) {
      int spread = 0;
      int dir = 1;
      if (formation == 1) {
        if (i < div(height, 2)) { dir = 1; } else { dir = 0 - 1; }
      }
      if (formation == 2) {
        spread = div(i * 255, height);
      }
      if (formation == 3) {
        if (mod(i, 2) == 1) { dir = 0 - 1; }
      }
      if (formation == 0) {
        spread = div(i * 128, height);
      }

      setPan(i, 128 + div((beatsin(panBpm, t + spread, 255) - 128) * dir * panRange, 256));
      setTilt(i, 128 + div((beatsin(tiltBpm, t + spread, 255) - 128) * tiltRange, 256));
    }
  }
}
