// Pulse: the whole rig flashes on the beat and decays between hits.

class PulseEffect {
  byte decay = 30;
  byte hueStep = 24;
  byte floorBri = 0;

  int lit = 0; // brightness left from the last beat
  int hue = 0; // palette position, walked per beat

  int dimensions() { return 1; }

  string tags() { return "💫🎵"; }

  void defineControls() {
    addControl("decay", decay, 1, 120); // how fast the flash falls away
    addControl("hueStep", hueStep, 0, 128); // palette steps per beat
    addControl("floorBri", floorBri, 0, 128); // never darker than this
  }

  void tick() {
    if (audioBeat() > 0) {
      lit = 255;
      hue = hue + hueStep;
    }
    if (lit > decay) { lit = lit - decay; }
    else { lit = 0; }

    if (lit < floorBri) { lit = floorBri; }
    fill(paletteR(hue, lit), paletteG(hue, lit), paletteB(hue, lit));
  }
}
